# --- Lamix panel (search engine) -----------------------------------------
LAMIX_BASE_URL=https://panel.lamix.org
LAMIX_USERNAME=your_lamix_username
LAMIX_PASSWORD=your_lamix_password

# Manual CLIs (always merged with Matrix and SignalPulse harvested ones)
LAMIX_CLIS=Lark
# Optional extra Lamix accounts, username:password,comma separated (never commit real passwords)
LAMIX_ACCOUNTS=user1:pass1,user2:pass2

# --- MatrixPanel (CLI source) --------------------------------------------
MATRIX_BASE_URL=https://matrixpanel.io
MATRIX_ENABLED=true
MATRIX_USERNAME=your_matrix_username
MATRIX_PASSWORD=your_matrix_password
# How often to re-harvest Matrix CLIs (minutes)
MATRIX_REFRESH_MINUTES=10
# Where harvested CLIs are saved (never lost across restarts)
CLI_FILE=./data/clis.json

# --- SignalPulse (fast public CLI telemetry source) -----------------------
SIGNAL_ENABLED=true
SIGNAL_BASE_URL=http://201.18.218.200:8080
SIGNAL_REFRESH_MINUTES=5

# --- Telegram -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:AAexamplePlaceholderToken
# Comma-separated chat ids. Leave empty to auto-discover, or set e.g.
# TELEGRAM_CHAT_ID=-1001234567890,-1009876543210
TELEGRAM_CHAT_ID=

# --- Behaviour -----------------------------------------------------------
POLL_SECONDS=10
WINDOW_MINUTES=2
RANGE_COOLDOWN_MINUTES=10
# 0 = no sharding. Otherwise search up to this many CLIs per loop.
CLIS_PER_CYCLE=6
MAX_CLIS=0
FUTURE_SKEW_SECONDS=30
SEARCH_PACING_MS=6000
CYCLE_SECONDS=180
LAMIX_SEARCH_TIMEOUT_MS=8000
LAMIX_PRIORITY_TIMEOUT_MS=15000

# --- Keep-alive self-ping -------------------------------------------------
SELF_PING_ENABLED=true
# Set to your public /healthz endpoint, e.g. https://example.com/healthz
SELF_PING_URL=
SELF_PING_MINUTES=2
PORT=10000

# --- Runtime -------------------------------------------------------------
STATE_FILE=./data/state.json
HEADLESS=true
DRY_RUN=false
