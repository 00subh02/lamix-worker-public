{
  "name": "lamix-cli-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Monitors Lamix SMS CLI Search and sends Telegram alerts for ranges active in the last N minutes.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/bot.js",
    "once": "node --env-file-if-exists=.env src/bot.js --once",
    "scan": "node --env-file-if-exists=.env src/bot.js --scan-once"
  },
  "dependencies": {
    "playwright": "^1.49.0"
  }
}
